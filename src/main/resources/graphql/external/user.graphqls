type UserBriefResponse {
    uuid: ID!
    name: String!
    email: String!
    phone: String
}

type ChatMessageResponse {
    uuid: ID!
    message: String!
    receptorName: String!
    createdAt: String!
}

type ChatConversationWithMessages {
    uuid: ID!
    emissorName: String!
    createdAt: String!
    messages: [ChatMessageResponse!]!
}

extend type Query {
    pubOrgUsers(slug: String!): [UserBriefResponse!]!
    pubUserConversations(orgSlug: String!, userUuid: ID!): [ChatConversationWithMessages!]!
}
