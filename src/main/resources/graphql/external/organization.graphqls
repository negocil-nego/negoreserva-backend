type ProductFileGetOrgResponse {
    uuid: ID!
    title: String
    description: String
    url: String
    type: String
    isPrimary: Boolean
}

type ProductGetOrganizationResponse {
    uuid: ID!
    name: String!
    slug: String!
    price: Float
    description: String
    type: String
    image: String
}

type ProductTagInfoGetOrgResponse {
    uuid: ID!
    icon: String
    title: String
    value: String
}

type ProductPriceGetOrgResponse {
    uuid: ID!
    type: String
    value: Float!
    order: Int
    isPrimary: Boolean
    unit: Int
}

type GetOrganizationProductFileResponse {
    product: ProductGetOrganizationResponse!
    files: [ProductFileGetOrgResponse!]!
    tags: [ProductTagInfoGetOrgResponse!]!
    prices: [ProductPriceGetOrgResponse!]!
}

type GetOrganizationResponse {
    organization: OrganizationResponse!
    categories: [CategoryResponse!]!
    products: [GetOrganizationProductFileResponse!]!
}

type GetOrganizationPaginate {
    content: [GetOrganizationResponse!]!
    empty: Boolean!
    first: Boolean!
    last: Boolean!
    number: Int!
    numberOfElements: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

type CatalogResponse {
    uuid: ID!
    name: String!
    description: String!
    imgUrl: String
    slug: String!
    type: CatalogType!
    organization: OrganizationResponse!
}

type OrganizationDetailResponse {
    uuid: ID
    name: String
    slug: String
    description: String
    address: String
    rating: String
    logo: String
    image: String
    video: String
    email: String
    phone: String
    categories: [CategoryResponse!]!
    products: [ProductDetailResponse!]!
    catalogs: [CatalogResponse!]!
    socialsMedia: OrganizationSocialMediaDetailResponse
    addresses: [AddressResponse!]!
}

extend type Query {
    pubPaginateGetOrganization(paginateRequest: PaginateRequest): GetOrganizationPaginate!
    pubPaginateGetOrganizationByCategories(categoryUuids: [ID!]!, paginateRequest: PaginateRequest): GetOrganizationPaginate!
    pubOrganizationDetail(uuidOrSlug: String): OrganizationDetailResponse
    pubSearchOrganization(q: String!, paginateRequest: PaginateRequest): OrganizationPaginate!
    pubSearchOrganizationFilter(filter: OrganizationSearchFilterParamInput!, paginateRequest: PaginateRequest): OrganizationPaginate!
    pubSearchCatalogFilter(filter: CatalogSearchFilterParamInput!, paginateRequest: PaginateRequest): CatalogPaginate!
    pubCatalogProducts(uuidOrSlug: String!): [ProductDetailResponse!]!
}

input OrganizationSearchFilterParamInput {
    q: String
    categoriesUuid: [ID!]
    province: String
    municipality: String
}

type CatalogPaginate {
    content: [CatalogResponse]!
    empty: Boolean!
    first: Boolean!
    last: Boolean!
    number: Int!
    numberOfElements: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input CatalogSearchFilterParamInput {
    q: String
    organizationUuids: [ID!]
}

enum CatalogType {
    NONE
    DRIK
    FOOD
}
