type OrgProductResponse {
    uuid: ID!
    name: String!
    slug: String!
    description: String
    files: [OrgProductFileResponse]
}

type ProductSuggestionResponse {
    categoryType: String!
    products: [String!]!
    tags: [String!]!
}

type OrgProductPaginate {
    content: [OrgProductResponse]!
    empty: Boolean
    first: Boolean
    last: Boolean
    number: Int
    numberOfElements: Int
    size: Int
    totalElements: Int
    totalPages: Int
}

extend type Query {
    orgPaginateProduct(paginateRequest: PaginateRequest): OrgProductPaginate!
    orgPaginateProductFilter(filter: ProductFilterQueryParamInput): OrgProductPaginate!
    orgFindByUuidProduct(uuid: ID!): OrgProductResponse
    orgProductSuggestions: [ProductSuggestionResponse!]!
}

extend type Mutation {
    orgSaveProduct(productRequest: ProductRequest!): OrgProductResponse
    orgUpdateProduct(uuid: ID!, productRequest: ProductRequest!): OrgProductResponse
    orgDeleteByUuidProduct(uuid: ID!): Boolean
}
