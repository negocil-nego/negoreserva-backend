type OrgUserResponse {
    uuid: ID!
    username: String!
    name: String!
    email: String!
    phone: String!
}

type UpdateDataResponse {
    id: ID!
    type: String
    field: String
    expiredAt: String
}

type OrganizationSocialMediaDetailResponse {
    uuid: ID!
    facebook: String
    instagram: String
    youtube: String
    tiKtok: String
    linkedin: String
}

type OrgOrganizationProfile {
    user: OrgUserResponse
    organization: OrganizationResponse
    updateDataResponse: [UpdateDataResponse]
    addresses: [AddressResponse]
    socialMedia: OrganizationSocialMediaDetailResponse
}

input OrganizationEditProfileRequest {
    name: String
    address: String
    description: String
}

input OrganizationSocialMediaEditRequest {
    facebook: String
    instagram: String
    youtube: String
    tiktok: String
    linkedin: String
}

input OrganizationAddressEditRequest {
    address: String!
}

input OrganizationAddressUpsertRequest {
    complement: String
    provinceUuid: ID!
    municipalityUuid: ID!
}

extend type Query {
    orgProfileOrganization: OrgOrganizationProfile
}

extend type Mutation {
    orgOrganizationUpdate(request: OrganizationEditProfileRequest): OrganizationResponse
    orgOrganizationUpdateSocialMedia(request: OrganizationSocialMediaEditRequest!): OrganizationResponse
    orgOrganizationUpdateAddress(request: OrganizationAddressEditRequest!): OrganizationResponse
    orgOrganizationUpsertAddress(request: OrganizationAddressUpsertRequest!): AddressResponse
    orgOrganizationSetDefaultAddress(addressUuid: ID!): AddressResponse
    orgOrganizationRemoveAddress(addressUuid: ID!): OrganizationResponse
}