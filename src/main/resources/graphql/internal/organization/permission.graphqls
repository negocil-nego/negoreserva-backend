type OrgRolePermissionResponse {
    uuid: ID!
    name: String!
    description: String
}

type OrgRolePermissions {
    assignedPermissions: [OrgRolePermissionResponse]!
    availablePermissions: [OrgRolePermissionResponse]!
}

extend type Query {
    orgFindAll: [PermissionResponse!]!
    orgPaginate(paginateRequest: PaginateRequest): PermissionResponsePaginate
    orgGetRolePermissions(roleUuid: ID!): OrgRolePermissions!
}