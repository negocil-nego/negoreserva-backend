type OrgPersonResponse {
    uuid: ID!
    name: String!
    email: String!
    phone: String!
    roles: [OrgRoleResponse]!
}

type OrgPersonRoles {
    assignedRoles: [OrgRoleResponse]!
    availableRoles: [OrgRoleResponse]!
}

type OrgUserPaginate {
    content: [OrgPersonResponse]!
    empty: Boolean!
    first: Boolean!
    last: Boolean!
    number: Int!
    numberOfElements: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
}

input OrgUserCreateRequest {
    name: String!
    email: String!
    phone: String!
    password: String
    roleUuids: [ID!]
}

input OrgUserUpdateRequest {
    name: String
    roleUuids: [ID!]
}

extend type Query {
    orgPaginatePerson(paginateRequest: PaginateRequest): OrgUserPaginate!
    orgFindByUuidPerson(uuid: ID!): OrgPersonResponse
    orgGetPersonRoles(userUuid: ID!): OrgPersonRoles!
}

extend type Mutation {
    orgSavePerson(personCreateRequest: OrgUserCreateRequest!): OrgPersonResponse
    orgUpdatePerson(uuid: ID!, personUpdateRequest: OrgUserUpdateRequest!): OrgPersonResponse
    orgDeleteByUuidPerson(uuid: ID!): Boolean
}
